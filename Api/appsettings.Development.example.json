{
  "WebAppUrl": "http://localhost:3000",
  "Database": {
    "AppDbConnection": "Host=localhost;Port=5432;Database=your_db_name;Username=postgres;Password=your_password"
  },
  "Receiver": {
    "EnableHttpIngestion": true,
    "MaxAcceptedClockSkewMinutes": 5,
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "RabbitMq": {
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "ObservationQueue": "receiver.observations.v1"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*"
}
