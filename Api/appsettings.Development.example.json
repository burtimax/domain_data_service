{
  "WebAppUrl": "http://localhost:3000",
  "AllowedOrigins": "http://localhost:3000,http://localhost:5173",
  "Database": {
    "AppDbConnection": "Host=localhost;Port=5432;Database=your_db_name;Username=postgres;Password=your_password"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "Token": {
    "SecretKey": "your-secret-key-at-least-32-characters-long-for-jwt-signing",
    "ExpiryMinutes": 1440,
    "Issuer": "TemplateMiniApp"
  },
  "Bot": {
    "Name": "YourBotName",
    "TelegramToken": "YOUR_BOT_TOKEN_FROM_BOTFATHER",
    "Webhook": "https://your-ngrok-url.ngrok-free.app",
    "ResourcesFilePath": "Resources.json",
    "DbConnection": "Host=localhost;Port=5432;Database=your_bot_db;Username=postgres;Password=your_password",
    "Password": "your-secure-password",
    "MediaDirectory": "/app/media",
    "ExceptionDirectory": "./exceptions"
  },
  "BotOptions": {
    "SaveUpdatesInDatabase": false,
    "SaveUserMessagesInDatabase": false,
    "SaveBotMessagesInDatabase": false,
    "SaveExceptionsInDatabase": true,
    "SaveExceptionsInDirectory": true,
    "BoundRequestsInSecond": 25
  },
  "BroadcastMessages": {
    "BroadcastDbConnection": "Host=localhost;Port=5432;Database=your_db_name;Username=postgres;Password=your_password",
    "MessageDelayMilliseconds": 100,
    "IsEnabled": false
  },
  "SMSGateway": {
    "Url": "https://sms-gateway-api-url.com",
    "Token": "YOUR_SMS_GATEWAY_TOKEN"
  },
  "AllowedHosts": "*"
}
