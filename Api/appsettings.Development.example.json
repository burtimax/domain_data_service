{
  "WebAppUrl": "http://localhost:3000",
  "Database": {
    "AppDbConnection": "Host=localhost;Port=5432;Database=your_db_name;Username=postgres;Password=your_password"
  },
  "Receiver": {
    "EnableHttpIngestion": false,
    "MaxAcceptedClockSkewMinutes": 5,
    "AllowedOrigins": [ "http://localhost:3000", "http://localhost:5173" ]
  },
  "RabbitMq": {
    "EnableConsumer": true,
    "MaxRetryAttempts": 3,
    "ReplayBatchSizeDefault": 50,
    "ReplayBatchSizeMax": 500,
    "DlqArchiveFilePath": "App_Data/dlq-archive.ndjson",
    "Host": "localhost",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "guest",
    "Password": "guest",
    "ObservationExchange": "receiver.observations.exchange",
    "ObservationRoutingKey": "receiver.observation.v1",
    "ObservationQueue": "receiver.observations.v1",
    "PrefetchCount": 10,
    "DlqExchange": "receiver.observations.dlx",
    "DlqRoutingKey": "receiver.observation.v1.dlq",
    "DlqQueue": "receiver.observations.v1.dlq"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Information"
    }
  },
  "AllowedHosts": "*"
}
